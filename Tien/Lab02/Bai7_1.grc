- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\nclass SquareSynth(gr.sync_block):\n    \"\"\"\n \
      \   Khoi nguon tong hop song vuong bang chuoi Fourier:\n    x(t) = amplitude\
      \ * (4 / pi) * SUM [ (1 / k) * sin(2 * pi * k * f0 * t) ]\n    voi k chay cac\
      \ so le: 1, 3, 5, ..., k_max\n    \"\"\"\n    def __init__(self, samp_rate=32000.0,\
      \ f0=1000.0, k_max=5, amplitude=1.0):\n        gr.sync_block.__init__(\n   \
      \         self,\n            name='Square Synth',\n            in_sig=None,\
      \                     # Khoi nguon (Source) khong co dau vao\n            out_sig=[np.float32]\
      \             # Dau ra tin hieu thuc kieu float\n        )\n        self.samp_rate\
      \ = float(samp_rate)\n        self.f0 = float(f0)\n        self.k_max = int(k_max)\n\
      \        self.amplitude = float(amplitude)\n        \n        # Bien luu vi\
      \ tri mau thoi gian t de tin hieu lien tuc giua cac goi mau\n        self.n\
      \ = 0\n\n        # Kiem tra dieu kien tan so Nyquist\n        nyquist_limit\
      \ = self.samp_rate / 2.0\n        if self.k_max * self.f0 >= nyquist_limit:\n\
      \            k_valid_max = int((nyquist_limit - 1) // self.f0)\n           \
      \ if k_valid_max % 2 == 0:\n                k_valid_max -= 1\n            print(f\"\
      \\n[CANH BAO NYQUIST]: k_max * f0 ({self.k_max * self.f0} Hz) >= samp_rate /\
      \ 2 ({nyquist_limit} Hz)!\")\n            print(f\"--> Gia tri k_max lon nhat\
      \ hop le de tranh chong pho: {k_valid_max}\\n\")\n\n    def work(self, input_items,\
      \ output_items):\n        out = output_items[0]\n        n_samples = len(out)\n\
      \n        # Tao truc thoi gian t cho block mau hien tai\n        t = (self.n\
      \ + np.arange(n_samples)) / self.samp_rate\n        \n        # Khoi tao mang\
      \ gia tri 0\n        signal = np.zeros(n_samples, dtype=np.float32)\n\n    \
      \    # Cong chuoi Fourier cac song hai bac le: 1, 3, 5, ..., k_max\n       \
      \ for k in range(1, self.k_max + 1, 2):\n            signal += (1.0 / k) * np.sin(2.0\
      \ * np.pi * k * self.f0 * t)\n\n        # Nhan he so (4/pi) cua song vuong va\
      \ bien do amplitude\n        signal = signal * (4.0 / np.pi) * self.amplitude\n\
      \n        out[:] = signal\n        self.n += n_samples  # Cap nhat tong so mau\
      \ da phat\n        return len(out)"
    affinity: ''
    alias: ''
    amplitude: '1'
    comment: ''
    f0: '1000'
    k_max: '31'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: '(''Square Synth'', ''SquareSynth'', [(''samp_rate'', ''32000.0''),
      (''f0'', ''1000.0''), (''k_max'', ''5''), (''amplitude'', ''1.0'')], [], [(''0'',
      ''float'', 1)], ''\n    Khoi nguon tong hop song vuong bang chuoi Fourier:\n    x(t)
      = amplitude * (4 / pi) * SUM [ (1 / k) * sin(2 * pi * k * f0 * t) ]\n    voi
      k chay cac so le: 1, 3, 5, ..., k_max\n    '', [''amplitude'', ''f0'', ''k_max'',
      ''samp_rate''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 264.0]
    rotation: 0
    state: enabled

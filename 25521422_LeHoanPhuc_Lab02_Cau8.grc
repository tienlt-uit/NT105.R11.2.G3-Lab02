-   name: epy_block_0
    id: epy_block
    parameters:
        _io_cache: '{"block_type":"sync","callbacks":["amplitude","f0","k_max","samp_rate"],"cls":"blk","decim":1,"doc":"","history":1,"interp":1,"itemsizes_in":[],"itemsizes_out":[4],"label":"Square Synth","max_noutput_items":0,"min_output_buffer":0,"msg_ports_in":[],"msg_ports_out":[],"output_multiple":0,"overrides_forecast":false,"params":[["samp_rate","32000"],["f0","1000"],["k_max","5"],["amplitude","1.0"]],"relative_rate":1,"sinks":[],"sources":[["0","float",1]],"tag_propagation_policy":1}'
        _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self, samp_rate=32000, f0=1000, k_max=5, amplitude=1.0):\n        gr.sync_block.__init__(\n            self,\n            name='Square Synth',\n            in_sig=None, # Kh\xF4ng c\xF3 c\u1ED5ng v\xE0o\n            out_sig=[np.float32]\n        )\n        self.samp_rate = samp_rate\n        self.f0 = f0\n        self.k_max = k_max\n        self.amplitude = amplitude\n        self.phase = 0.0\n\n        # Ki\u1EC3m tra Nyquist\n        if k_max * f0 >= samp_rate / 2:\n            k_max_valid = int((samp_rate / 2) // f0) - 1\n            print(f\"CANH BAO: k_max*f0 = {k_max*f0} Hz vuot qua Nyquist! k_max toi da hop le la: {k_max_valid}\")\n\n    def work(self, input_items, output_items):\n        out = output_items[0]\n        n = len(out)\n        t = (np.arange(n) + self.phase) / self.samp_rate\n        \n        # T\xEDnh t\u1ED5ng chu\u1ED7i Fourier\n        s = np.zeros(n, dtype=np.float64)\n        for k in range(1, self.k_max + 1, 2): \n            s += np.sin(2 * np.pi * k * self.f0 * t) / k\n            \n        out[:] = self.amplitude * (4 / np.pi) * s\n        self.phase += n\n        return n"
        affinity: ''
        alias: ''
        amplitude: '1'
        comment: ''
        f0: '1000'
        k_max: '31'
        samp_rate: '32000'
    states:
        coordinate: [100, 310]
        rotation: 0
        state: enabled

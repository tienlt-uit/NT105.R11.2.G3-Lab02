- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, code='NRZ-L', samples_per_bit=64, seed=0):\n       \
      \ gr.sync_block.__init__(self, name='Line Code Source',\n                  \
      \             in_sig=None, out_sig=[np.float32])\n        self.code = str(code)\n\
      \        self.spb = int(samples_per_bit)\n        self.rng = np.random.default_rng(int(seed))\n\
      \        self.nrzi_level = 0.0\n        self.ami_last = -1.0\n        self.set_output_multiple(self.spb)\n\
      \n    def encode(self, bits):\n        c = self.code.upper()\n        spb, half\
      \ = self.spb, self.spb // 2\n        if c == 'NRZ-L':\n            return np.repeat(np.where(bits\
      \ == 1, 0.0, 1.0), spb)\n        if c == 'NRZI':\n            lv = []\n    \
      \        for b in bits:\n                if b == 1:\n                    self.nrzi_level\
      \ = 1.0 - self.nrzi_level\n                lv.append(self.nrzi_level)\n    \
      \        return np.repeat(lv, spb)\n        if c == 'AMI':\n            lv =\
      \ []\n            for b in bits:\n                if b == 1:\n             \
      \       self.ami_last = -self.ami_last\n                    lv.append(self.ami_last)\n\
      \                else:\n                    lv.append(0.0)\n            return\
      \ np.repeat(lv, spb)\n        if c == 'MANCHESTER':\n            out = []\n\
      \            for b in bits:\n                a, d = (1.0, -1.0) if b == 0 else\
      \ (-1.0, 1.0)\n                out += [a] * half + [d] * (spb - half)\n    \
      \        return np.array(out)\n        raise ValueError('code khong hop le')\n\
      \n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        nbit = len(out) // self.spb\n        bits = self.rng.integers(0, 2,\
      \ nbit)\n        out[:nbit * self.spb] = self.encode(bits)\n        return nbit\
      \ * self.spb"
    affinity: ''
    alias: ''
    code: '''MANCHESTER'''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_bit: '64'
    seed: '0'
  states:
    _io_cache: ('Line Code Source', 'blk', [('code', "'NRZ-L'"), ('samples_per_bit',
      '64'), ('seed', '0')], [], [('0', 'float', 1)], '', ['code'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 252.0]
    rotation: 0
    state: enabled

- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, threshold=0.5):\n        gr.sync_block.__init__(\n \
      \           self,\n            name='Switch',\n            in_sig=[np.float32,\
      \ np.float32, np.float32],\n            out_sig=[np.float32]\n        )\n  \
      \      self.threshold = float(threshold)\n\n    def work(self, input_items,\
      \ output_items):\n        in1 = input_items[0]\n        control = input_items[1]\n\
      \        in3 = input_items[2]\n        output_items[0][:] = np.where(control\
      \ >= self.threshold, in1, in3)\n        return len(control)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold: '0.5'
  states:
    _io_cache: ('Switch', 'blk', [('threshold', '0.5')], [('0', 'float', 1), ('1',
      'float', 1), ('2', 'float', 1)], [('0', 'float', 1)], '', ['threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 276.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, samp_rate=32000, bit_rate=500.0,\n                 minimum=0.0,\
      \ maximum=1.0, seed=0):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Random Number',\n            in_sig=None,\n            out_sig=[np.float32]\n\
      \        )\n        self.minimum = float(minimum)\n        self.maximum = float(maximum)\n\
      \        self.spb = int(samp_rate / bit_rate)\n        self.rng = np.random.default_rng(int(seed))\n\
      \        self.set_output_multiple(self.spb)\n\n    def work(self, input_items,\
      \ output_items):\n        count = len(output_items[0])\n        nbit = count\
      \ // self.spb\n        values = self.rng.uniform(self.minimum, self.maximum,\
      \ nbit)\n        output_items[0][:] = np.repeat(values, self.spb)\n        return\
      \ count"
    affinity: ''
    alias: ''
    bit_rate: bit_rate
    comment: ''
    maximum: '1'
    maxoutbuf: '0'
    minimum: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    seed: '0'
  states:
    _io_cache: ('Random Number', 'blk', [('samp_rate', '32000'), ('bit_rate', '500.0'),
      ('minimum', '0.0'), ('maximum', '1.0'), ('seed', '0')], [], [('0', 'float',
      1)], '', ['maximum', 'minimum'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 288.0]
    rotation: 0
    state: enabled

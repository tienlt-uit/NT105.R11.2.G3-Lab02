-   name: epy_block_1
    id: epy_block
    parameters:
        _io_cache: '{"block_type":"sync","callbacks":["distance","freq","snr_db"],"cls":"blk","decim":1,"doc":"","history":1,"interp":1,"itemsizes_in":[4],"itemsizes_out":[4],"label":"Channel","max_noutput_items":0,"min_output_buffer":0,"msg_ports_in":[],"msg_ports_out":[],"output_multiple":0,"overrides_forecast":false,"params":[["distance","1.0"],["freq","2400000000.0"],["snr_db","30.0"]],"relative_rate":1,"sinks":[["0","float",1]],"sources":[["0","float",1]],"tag_propagation_policy":1}'
        _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self, distance=1.0, freq=2.4e9, snr_db=30.0):\n        gr.sync_block.__init__(\n            self,\n            name='Channel',\n            in_sig=[np.float32],\n            out_sig=[np.float32]\n        )\n        self.distance = distance\n        self.freq = freq\n        self.snr_db = snr_db\n        self.rng = np.random.default_rng(0)\n\n        # T\xEDnh suy hao kh\xF4ng gian t\u1EF1 do (FSL)\n        c = 299792458.0\n        lam = c / freq\n        fsl = (4 * np.pi * distance / lam) ** 2 \n        \n        # TH\xCAM D\xD2NG N\xC0Y: H\u1EC7 s\u1ED1 Gain \u0111\u1EC3 t\xEDn hi\u1EC7u kh\xF4ng b\u1ECB ch\xECm v\u1EC1 0 tr\xEAn \u0111\u1ED3 th\u1ECB\n        Gain = 1000.0 \n        \n        # S\u1EEDa c\xF4ng th\u1EE9c: nh\xE2n th\xEAm Gain v\xE0o tr\u01B0\u1EDBc khi l\u1EA5y c\u0103n b\u1EADc 2\n        self.atten = np.sqrt(Gain / fsl) \n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n        out = output_items[0]\n\n        # 1. Suy hao t\xEDn hi\u1EC7u\n        y = x * self.atten\n\n        # 2. C\u1ED9ng nhi\u1EC5u Gauss\n        sig_power = np.mean(x ** 2) * self.atten ** 2\n        noise_power = sig_power / (10 ** (self.snr_db / 10))\n        sigma = np.sqrt(noise_power)\n        y = y + self.rng.normal(0.0, sigma, len(y))\n\n        out[:] = y\n        return len(out)"
        affinity: ''
        alias: ''
        comment: ''
        distance: '8'
        freq: '2.4e9'
        snr_db: '30.0'
    states:
        coordinate: [770, 380]
        rotation: 0
        state: enabled
